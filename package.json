{
  "name": "unpen",
  "version": "0.1.0",
  "description": "Convert pen.dev .pen designs to OpenPencil, Figma, and Doop",
  "license": "MIT",
  "type": "module",
  "bin": {
    "unpen": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup": "node scripts/setup.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:samples": "node --test --test-concurrency=1 test/samples/*.test.ts",
    "unpen": "node src/cli.ts"
  },
  "dependencies": {
    "@open-pencil/cli": "^0.16.0",
    "bun": "1.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3"
  },
  "private": true
}
